#!/bin/sh
# YBCO-TA-3.0 commit-msg：校验 Machine: trailer 是否齐全
# （由 sync/install_hooks.py 安装）
#
# 参数：$1 = 消息文件路径。退出码 1 会让 git 中止本次提交。
#
# 逃生阀：YBCO_SKIP_HOOKS=1 git commit ...
set -u

PY=""
for cand in python python3 py; do
    if command -v "$cand" >/dev/null 2>&1; then
        if [ "$cand" = "py" ]; then
            if py -3 -c "" >/dev/null 2>&1; then PY="py -3"; break; fi
        else
            if "$cand" -c "" >/dev/null 2>&1; then PY="$cand"; break; fi
        fi
    fi
done

if [ -z "$PY" ]; then
    echo "commit-msg: 找不到可用的 python，跳过机器标识校验。" >&2
    echo "           修复：重跑 python sync/install_hooks.py install" >&2
    exit 0
fi

# shellcheck disable=SC2086
# 注意：`--check` 是布尔开关，不接受取值，消息文件必须走 `--file`。
# 写成 `--check "$1"` 会让 argparse 把文件路径当成多余的位置参数而报
# "unrecognized arguments"——实测踩过，改这里时别再合并成一条。
exec $PY "$(git rev-parse --show-toplevel)/sync/trailer.py" --check --file "$1"
